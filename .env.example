# Supabase 프로젝트 설정 (https://supabase.com/dashboard 에서 생성)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# 서버 전용 (API 라우트에서만 사용, 절대 클라이언트에 노출 금지)
# Supabase 대시보드 > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 배포 후 사이트 기본 URL (OAuth 콜백 리디렉션에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 넥슨 오픈 API 연동용 암호화 키 (각 사용자가 자기 API 키를 저장할 때 암호화)
# openssl rand -base64 32 로 생성
NEXON_KEY_ENCRYPTION_SECRET=change-me-to-a-random-32-byte-base64-string
